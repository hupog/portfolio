<section
  id="inicio"
  class="relative min-h-screen flex items-center justify-center overflow-hidden"
>
  <div class="absolute inset-0 -z-10"></div>

  <div class="z-10 text-center">
    <h1 class="text-5xl font-bold mb-4">Hola, soy Hugo González Portilla</h1>
    <p class="text-xl max-w-xl mx-auto">
      Fullstack Developer graduado en Ingeniería Informática con experiencia
      profesional en desarrollo web, trabajando tanto en frontend como en
      backend. Busco seguir creciendo con nuevos retos que me permitan aprender
      cada día, adaptarme a distintos entornos y aportar valor desde el primer
      momento.
    </p>
  </div>

  <script>
    const { animate, inView } = await import("@motionone/dom");

    inView("#intro", () => {
      animate("#intro h1", { opacity: [0, 1], y: [-50, 0] }, { duration: 1 });
      animate(
        "#intro p",
        { opacity: [0, 1], y: [30, 0] },
        { delay: 0.5, duration: 1 }
      );
    });
  </script>
</section>
